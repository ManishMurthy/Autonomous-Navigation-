<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cropmap_nav2</name>
  <version>0.0.0</version>
  <description>CropMap V0 Navigation with Nav2 and SLAM</description>
  <maintainer email="manishmurthy080@gmail.com">Manish Murthy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_common</depend>
  <depend>nav2_bringup</depend>
  <depend>slam_toolbox</depend>
  <depend>nav2_map_server</depend>
  <depend>rviz2</depend>
  <depend>robot_description</depend>
  <depend>robot_bringup</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
