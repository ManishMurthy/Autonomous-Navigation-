#!/usr/bin/env python3
import os
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, GroupAction
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution
from launch_ros.actions import Node, SetRemap
from launch_ros.substitutions import FindPackageShare
from ament_index_python.packages import get_package_share_directory

def generate_launch_description():
    # Get package directories
    cropmap_nav2_dir = get_package_share_directory('cropmap_nav2')
    vox_nav_bringup_dir = get_package_share_directory('vox_nav_bringup')
    
    # Launch configuration variables
    use_sim_time = LaunchConfiguration('use_sim_time')
    voxnav_params_file = LaunchConfiguration('voxnav_params_file')
    robot_localization_params_file = LaunchConfiguration('robot_localization_params_file')
    
    # Declare launch arguments
    declare_use_sim_time_cmd = DeclareLaunchArgument(
        'use_sim_time', 
        default_value='true', 
        description='Use simulation clock'
    )
    
    declare_voxnav_params_file_cmd = DeclareLaunchArgument(
        'voxnav_params_file',
        default_value=os.path.join(cropmap_nav2_dir, 'config', 'voxnav_params.yaml'),
        description='Full path to VoxNav parameters'
    )
    
    declare_robot_localization_params_file_cmd = DeclareLaunchArgument(
        'robot_localization_params_file',
        default_value=os.path.join(vox_nav_bringup_dir, 'params', 'robot_localization_params.yaml'),
        description='Full path to robot localization parameters'
    )

    # Static transforms for VoxNav
    static_transform_map_odom = Node(
        package='tf2_ros',
        executable='static_transform_publisher',
        name='map_odom_publisher',
        arguments=['0', '0', '0', '0', '0', '0', 'map', 'odom'],
        parameters=[{'use_sim_time': use_sim_time}]
    )

    # Base footprint to base_link transform
    base_footprint_to_base_link = Node(
        package='tf2_ros',
        executable='static_transform_publisher',
        name='base_footprint_to_base_link',
        arguments=['0', '0', '0', '0', '0', '0', 'base_footprint', 'base_link'],
        parameters=[{'use_sim_time': use_sim_time}]
    )

    # VoxNav Core Nodes
    vox_nav_planner_server = Node(
        package='vox_nav_planning',
        executable='planner_server',
        name='vox_nav_planner_server',
        output='screen',
        parameters=[voxnav_params_file, {'use_sim_time': use_sim_time}],
        remappings=[
            ('/scan', '/scan'),
            ('/odom', '/odom'),
            ('/cmd_vel', '/cmd_vel')
        ]
    )

    vox_nav_controller_server = Node(
        package='vox_nav_control',
        executable='controller_server',
        name='vox_nav_controller_server',
        output='screen',
        parameters=[voxnav_params_file, {'use_sim_time': use_sim_time}],
        remappings=[
            ('/scan', '/scan'),
            ('/odom', '/odom'),
            ('/cmd_vel', '/cmd_vel')
        ]
    )

    vox_nav_navigator = Node(
        package='vox_nav_navigators',
        executable='navigate_to_pose_action_server_node',
        name='vox_nav_navigator',
        output='screen',
        parameters=[voxnav_params_file, {'use_sim_time': use_sim_time}]
    )

    # Map Manager (3D mapping)
    vox_nav_map_manager = Node(
        package='vox_nav_map_server',
        executable='map_manager',
        name='vox_nav_map_manager',
        output='screen',
        parameters=[voxnav_params_file, {'use_sim_time': use_sim_time}],
        remappings=[
            ('/scan', '/scan'),
            ('/odom', '/odom')
        ]
    )

    # Robot Localization (EKF)
    robot_localization_node = Node(
        package='robot_localization',
        executable='ekf_node',
        name='ekf_filter_node',
        output='screen',
        parameters=[robot_localization_params_file, {'use_sim_time': use_sim_time}],
        remappings=[
            ('/odometry/filtered', '/odom'),
            ('/set_pose', '/initialpose')
        ]
    )

    # RViz with VoxNav visualization
    rviz_config_file = os.path.join(cropmap_nav2_dir, 'rviz2', 'voxnav_visualization.rviz')
    rviz_node = Node(
        package='rviz2',
        executable='rviz2',
        name='rviz2',
        arguments=['-d', rviz_config_file],
        parameters=[{'use_sim_time': use_sim_time}],
        output='screen'
    )

    # Create the launch description
    ld = LaunchDescription()
    
    # Add launch arguments
    ld.add_action(declare_use_sim_time_cmd)
    ld.add_action(declare_voxnav_params_file_cmd)
    ld.add_action(declare_robot_localization_params_file_cmd)
    
    # Add nodes
    ld.add_action(static_transform_map_odom)
    ld.add_action(base_footprint_to_base_link)
    ld.add_action(robot_localization_node)
    ld.add_action(vox_nav_map_manager)
    ld.add_action(vox_nav_planner_server)
    ld.add_action(vox_nav_controller_server)
    ld.add_action(vox_nav_navigator)
    ld.add_action(rviz_node)
    
    return ld
