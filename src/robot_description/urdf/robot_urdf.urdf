  </joint>
  <!-- ========================================= -->
  <!-- GAZEBO FORTRESS PLUGINS -->
  <!-- ========================================= -->
  <gazebo>
    <!-- Skid Steering Drive Plugin using Differential Drive for 4 wheels -->
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <!-- Left side wheels -->
      <left_joint>wheel_front_left_joint</left_joint>
      <left_joint>wheel_back_left_joint</left_joint>
      <!-- Right side wheels -->
      <right_joint>wheel_front_right_joint</right_joint>
      <right_joint>wheel_back_right_joint</right_joint>
      <!-- Robot dimensions (calculated from your URDF) -->
      <wheel_separation>0.5604</wheel_separation>
      <!-- Distance between left and right wheels -->
      <wheel_radius>0.1</wheel_radius>
      <!-- Approximate wheel radius -->
      <!-- Control topics -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!-- Reference frames -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <!-- Publishing settings -->
      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <!-- Performance limits -->
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
    <!-- Joint State Publisher -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <!-- Pose Publisher -->
    <plugin filename="libignition-gazebo-pose-publisher-system.so" name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
    </plugin>
  </gazebo>
  <!-- Lidar Sensor Plugin -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </sensor>
  </gazebo>
  <!-- Front Camera Plugin -->
  <gazebo reference="front_camera_dummy">
    <sensor name="front_camera_sensor" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>front_camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </sensor>
  </gazebo>
  <!-- Back Camera Plugin -->
  <gazebo reference="back_camera_dummy">
    <sensor name="back_camera_sensor" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>back_camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
