    <mu2>0.8</mu2>
    <fdir1>1 0 0</fdir1>
    <slip1>0.1</slip1>
    <slip2>0.1</slip2>
  </gazebo>
  <!-- Base Link Material -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
