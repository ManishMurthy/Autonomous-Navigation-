<?xml version="1.0" ?>
<robot name="cropMap_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.018582 -0.00058815 -0.099852" rpy="0 0 0" />
      <mass value="32.31" />
      <inertia ixx="0.92" ixy="0" ixz="0" iyy="3.12" iyz="0" izz="1.2" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
	      <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <!-- Front Right Wheel -->
  <link name="wheel_front_right">
    <inertial>
      <origin xyz="-3.8916E-11 0.012822 1.02E-07" rpy="0 0 0" />
      <mass value="2.5" />  <!-- Increased mass for better physics -->
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.04" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/wheel_front_right.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/wheel_front_right.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <origin xyz="0.37976 0.2802 -0.078259" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_front_right" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.05" />
  </joint>

  <!-- Back Right Wheel -->
  <link name="wheel_back_right">
    <inertial>
      <origin xyz="-3.8916E-11 0.012822 1.02E-07" rpy="0 0 0" />
      <mass value="2.5" />
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.04" />
