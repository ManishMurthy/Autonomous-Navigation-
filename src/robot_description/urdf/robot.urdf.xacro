  <!-- Back Camera -->
  <link name="back_camera">
    <inertial>
      <origin xyz="-0.032487 0.0089676 -0.0027971" rpy="0 0 0" />
      <mass value="0.2" />  <!-- Added mass for physics -->
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/back_camera.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
  </link>
  <joint name="back_camera_joint" type="fixed">
    <origin xyz="-0.40479 -0.0089685 0.073466" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="back_camera" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- Front Camera -->
  <link name="front_camera">
    <inertial>
      <origin xyz="0.012395 -0.012586 0.0091516" rpy="0 0 0" />
      <mass value="0.2" />  <!-- Added mass for physics -->
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/front_camera.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <origin xyz="0.42423 0.0126 0.060602" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_camera" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- TC_V0 Component -->
  <link name="TC_V0">
    <inertial>
      <origin xyz="-7.5077E-05 -2.3538E-06 -0.015092" rpy="0 0 0" />
      <mass value="14.01" />
      <inertia ixx="0.66" ixy="0.0" ixz="0.0" iyy="1.01" iyz="0.0" izz="1.66" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/TC_V0.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/manish/eiratech_ws/install/robot_description/share/robot_description/meshes/TC_V0.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="TC_V0_joint" type="fixed">
    <origin xyz="0 0 0.16825" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="TC_V0" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- Camera Dummy Links (keep existing) -->
  <link name="front_camera_dummy"/>
  <joint name="front_camera_dummy_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
    <parent link="front_camera" />
    <child link="front_camera_dummy" />
    <axis xyz="1 0 0" />
  </joint>

  <link name="back_camera_dummy"/>
  <joint name="back_camera_dummy_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 1.5708" />
    <parent link="back_camera" />
    <child link="back_camera_dummy" />
    <axis xyz="1 0 0" />
  </joint>

  <!-- ========================================= -->
  <!-- ADDED SENSORS -->
  <!-- ========================================= -->

  <!-- Lidar Sensor -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.08" />
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.08" />
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0.2" rpy="0 0 0" />  <!-- Mounted on top of robot -->
    <parent link="TC_V0" />
    <child link="lidar_link" />
  </joint>

  <!-- IMU Sensor -->
    <!-- IMU Sensor -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.02" />
      </geometry>
      <material name="imu_green">
        <color rgba="0.2 0.8 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.02" />
      </geometry>
    </collision>
  </link>
    <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>


  <!-- GPS Antenna -->
  <link name="gps_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.1" />
      </geometry>
      <material name="gps_yellow">
        <color rgba="0.8 0.8 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="gps_joint" type="fixed">
    <origin xyz="-0.2 0 0.5" rpy="0 0 0" />  <!-- Behind lidar -->
    <parent link="base_link" />
    <child link="gps_link" />
  </joint>

  <gazebo>
  <plugin name="skid_steering_drive_controller" filename="libgazebo_ros_diff_drive.so">
  
    <updateRate>100</updateRate>  <!-- Higher update rate -->
    <robotNamespace>/</robotNamespace>
    
    <!-- Wheel joints -->
    <num_wheel_pairs>2</num_wheel_pairs>
    <left_joint>wheel_front_left_joint</left_joint>
    <left_joint>wheel_back_left_joint</left_joint>
    <right_joint>wheel_front_right_joint</right_joint>
    <right_joint>wheel_back_right_joint</right_joint>

    <!-- Robot parameters -->
    <wheel_separation>0.5604</wheel_separation>
    <wheel_diameter>0.156</wheel_diameter>
    <torque>50</torque>
    
    <!-- Topics -->
    <command_topic>cmd_vel</command_topic>
    <odometry_topic>odom</odometry_topic>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>
    
    <!-- Publishing -->
    <publish_wheel_tf>true</publish_wheel_tf>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    
    <covariance_x>0.0001</covariance_x>
    <covariance_y>0.0001</covariance_y>
    <covariance_yaw>0.01</covariance_yaw>
  </plugin>
</gazebo>

  <gazebo>
   <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <update_rate>50</update_rate>
    <joint_name>wheel_front_left_joint</joint_name>
    <joint_name>wheel_front_right_joint</joint_name>
    <joint_name>wheel_back_left_joint</joint_name>
    <joint_name>wheel_back_right_joint</joint_name>
  </plugin>
</gazebo>    
  
  <!-- Lidar -->
  <gazebo reference="lidar_link">
  <sensor type="ray" name="lidar_sensor">
    <pose>0 0 0 0 0 0</pose>
    <visualize>false</visualize>
    <update_rate>20</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.1</min>
        <max>15.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.02</stddev>
      </noise>
    </ray>
    <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
  <ros>
    <namespace>/</namespace>
    <remapping>~/out:=scan</remapping>
   </ros>
    <output_type>sensor_msgs/LaserScan</output_type>
    <frame_name>lidar_link</frame_name>
  </plugin>
  </sensor>
</gazebo>

<!-- Front camera -->
<gazebo reference="back_camera">
  <sensor type="depth" name="back_camera">
    <update_rate>20</update_rate>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>10</far>
      </clip>
    </camera>
    <plugin name="back_camera_controller" filename="libgazebo_ros_camera.so">
      <baseline>0.2</baseline>
      <alwaysOn>true</alwaysOn>
      <updateRate>0.0</updateRate>
      <cameraName>back_camera</cameraName>
      <imageTopicName>back_camera/image_raw</imageTopicName>
      <depthImageTopicName>back_camera/depth/image_raw</depthImageTopicName>
      <pointCloudTopicName>back_camera/points</pointCloudTopicName>
      <cameraInfoTopicName>back_camera/camera_info</cameraInfoTopicName>
      <frame_name>back_camera</frame_name>
    </plugin>
  </sensor>
</gazebo>

  <!-- Back Camera -->
  <gazebo reference="front_camera">
        <sensor type="depth" name="front_camera">
          <update_rate>100</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <format>R8G8B8</format>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.5</near>
              <far>20</far>
            </clip>
          </camera>
          <plugin name="front_camera_controller" filename="libgazebo_ros_camera.so">
            <alwaysOn>true</alwaysOn>
            <updateRate>20</updateRate>
            <cameraName>front_camera</cameraName>
            <imageTopicName>rgb/image_raw</imageTopicName>
            <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
            <depthImageTopicName>depth/image_raw</depthImageTopicName>
            <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
            <pointCloudTopicName>depth/points</pointCloudTopicName>
            <frame_name>front_camera_dummy</frame_name>
            <distortion_k1>0.0</distortion_k1>
            <distortion_k2>0.0</distortion_k2>
            <distortion_k3>0.0</distortion_k3>
            <distortion_t1>0.0</distortion_t1>
            <distortion_t2>0.0</distortion_t2>
            <pointCloudCutoff>0.8</pointCloudCutoff>
            <pointCloudCutoffMax>3.5</pointCloudCutoffMax>     
          </plugin>
        </sensor>
      </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <update_rate>100</update_rate>
    <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
      <topicName>imu</topicName>
      <bodyName>imu_link</bodyName>
      <updateRateHZ>100.0</updateRateHZ>
      <gaussianNoise>0.0</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
      <frameName>imu_link</frameName>
    </plugin>
  </sensor>
</gazebo>

  <!-- GPS sensor -->
  <gazebo reference="gps_link">
  <sensor name="gps_sensor" type="gps">
    <update_rate>5</update_rate>
    <plugin name="gazebo_ros_gps" filename="libgazebo_ros_gps_sensor.so">
      <topicName>gps/fix</topicName>
      <frameName>gps_link</frameName>
      <updateRate>5.0</updateRate>
      <gaussianNoise>0.0001</gaussianNoise>
    </plugin>
  </sensor>
</gazebo>

  <!-- Wheel Physics Properties -->
  <gazebo reference="wheel_front_left">
    <material>Gazebo/Black</material>
    <surface>
    <friction>
      <ode>
        <mu>0.4</mu>        <!-- ✅ Reduced longitudinal friction for easier turning -->
        <mu2>1.0</mu2>      <!-- ✅ Higher lateral friction for forward traction -->
        <fdir1>0 1 0</fdir1> <!-- ✅ Friction direction (wheel axis) -->
        <slip1>0.1</slip1>   <!-- ✅ Allow some lateral slip for skid-steering -->
        <slip2>0.0</slip2>   <!-- ✅ No longitudinal slip -->
      </ode>
    </friction>
    <contact>
      <ode>
        <soft_cfm>0.0</soft_cfm>
        <soft_erp>0.2</soft_erp>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
      </ode>
    </contact>
  </surface>
 </gazebo>

  <gazebo reference="wheel_front_right">
    <material>Gazebo/Black</material>
    <surface>
    <friction>
      <ode>
        <mu>0.4</mu>        <!-- ✅ Reduced longitudinal friction for easier turning -->
        <mu2>1.0</mu2>      <!-- ✅ Higher lateral friction for forward traction -->
        <fdir1>0 1 0</fdir1> <!-- ✅ Friction direction (wheel axis) -->
        <slip1>0.1</slip1>   <!-- ✅ Allow some lateral slip for skid-steering -->
        <slip2>0.0</slip2>   <!-- ✅ No longitudinal slip -->
      </ode>
    </friction>
    <contact>
      <ode>
        <soft_cfm>0.0</soft_cfm>
        <soft_erp>0.2</soft_erp>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
      </ode>
    </contact>
  </surface>
 </gazebo>

