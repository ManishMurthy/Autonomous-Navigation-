    <material>Gazebo/Black</material>
    <surface>
    <friction>
      <ode>
        <mu>0.4</mu>        <!-- ✅ Reduced longitudinal friction for easier turning -->
        <mu2>1.0</mu2>      <!-- ✅ Higher lateral friction for forward traction -->
        <fdir1>0 1 0</fdir1> <!-- ✅ Friction direction (wheel axis) -->
        <slip1>0.1</slip1>   <!-- ✅ Allow some lateral slip for skid-steering -->
        <slip2>0.0</slip2>   <!-- ✅ No longitudinal slip -->
      </ode>
    </friction>
    <contact>
      <ode>
        <soft_cfm>0.0</soft_cfm>
        <soft_erp>0.2</soft_erp>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
      </ode>
    </contact>
  </surface>
 </gazebo>

  <!-- Base Link Material -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
