<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="my_field_map_world">
    
    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Border Walls (Black boundary in your map) -->
    <model name="wall_north">
      <static>true</static>
      <pose>10 19.9 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20 0.2 1</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>10 0.1 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20 0.2 1</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </collision>
