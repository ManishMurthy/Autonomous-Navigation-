        <collision name="collision">
          <geometry><box><size>0.2 20 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Large Rectangular Obstacles (Black rectangles in your map) -->
    
    <!-- Upper left square obstacle -->
    <model name="obstacle_square_1">
      <static>true</static>
      <pose>6 14 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 2 1</size></box></geometry>
